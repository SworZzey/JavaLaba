<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sworzzey.storecatalog.ui.HelloController">
   <bottom>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="btnLoadCsv" mnemonicParsing="false" onAction="#onAddCsvClicked" text="Загрузить CSV" />
            <Button fx:id="btnSaveCsv" mnemonicParsing="false" onAction="#onSaveCsvClicked" text="Сохранить CSV" />
            <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#onAddClicked" text="Добавить" />
            <Button fx:id="btnEdit" mnemonicParsing="false" onAction="#onEditClicked" text="Изменить" />
            <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#onDeleteClicked" text="Удалить" />
            <FlowPane prefHeight="100.0" prefWidth="365.0">
               <children>
                  <TextField fx:id="productAmount" />
                  <Button fx:id="btnGenerate" mnemonicParsing="false" onAction="#onGenerateClicked" text="Сгенерировать" />
                  <Button fx:id="btnStop" mnemonicParsing="false" onAction="#onStopClicked" prefHeight="30.0" prefWidth="94.0" text="Отменить" />
                  <ProgressBar fx:id="progressBar" prefWidth="200.0" progress="0.0">
                     <FlowPane.margin>
                        <Insets top="10.0" />
                     </FlowPane.margin>
                  </ProgressBar>
                  <Button fx:id="btnFind" mnemonicParsing="false" onAction="#onFindClicked" text="Найти" />
                  <Button fx:id="btnStats" mnemonicParsing="false" onAction="#onStatsClicked" text="Статистика" />
               </children>
            </FlowPane>
         </children>
      </HBox>
   </bottom>
    <center>
        <SplitPane dividerPositions="0.5" orientation="VERTICAL" BorderPane.alignment="CENTER">
            <items>
                <TableView fx:id="productTable" minHeight="120.0">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="typeColumn" prefWidth="90.0" text="Тип" />
                        <TableColumn fx:id="articleColumn" prefWidth="90.0" text="Артикул" />
                        <TableColumn fx:id="nameColumn" prefWidth="160.0" text="Название" />
                        <TableColumn fx:id="categoryColumn" prefWidth="120.0" text="Категория" />
                        <TableColumn fx:id="priceColumn" prefWidth="90.0" text="Цена" />
                        <TableColumn fx:id="stockColumn" prefWidth="80.0" text="Остаток" />
                        <TableColumn fx:id="warrantyColumn" prefWidth="90.0" text="Гарантия" />
                    </columns>
                </TableView>
                <VBox minHeight="120.0" spacing="4.0">
                    <padding>
                        <Insets bottom="6.0" left="8.0" right="8.0" top="6.0" />
                    </padding>
                    <children>
                        <ScrollPane pannable="true" style="-fx-background: white;" VBox.vgrow="ALWAYS">
                            <content>
                                <Canvas fx:id="treeCanvas" height="200.0" width="400.0" />
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </center>
</BorderPane>
