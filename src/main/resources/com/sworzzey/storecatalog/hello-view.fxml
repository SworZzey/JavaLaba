<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sworzzey.storecatalog.ui.HelloController">
   <center>
      <TableView fx:id="productTable" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
            <TableColumn fx:id="typeColumn" prefWidth="75.0" text="Тип" />
          <TableColumn fx:id="articleColumn" prefWidth="75.0" text="Артикул" />
          <TableColumn fx:id="nameColumn" prefWidth="75.0" text="Название" />
            <TableColumn fx:id="categoryColumn" prefWidth="75.0" text="Категория" />
            <TableColumn fx:id="priceColumn" prefWidth="75.0" text="Цена" />
            <TableColumn fx:id="stockColumn" prefWidth="75.0" text="Остаток" />
            <TableColumn fx:id="warrantyColumn" prefWidth="75.0" text="Гарантия" />
        </columns>
      </TableView>
   </center>
   <bottom>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="btnLoadCsv" mnemonicParsing="false" onAction="#onAddCsvClicked" text="Загрузить CSV" />
            <Button fx:id="btnSaveCsv" mnemonicParsing="false" onAction="#onSaveCsvClicked" text="Сохранить CSV" />
            <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#onAddClicked" text="Добавить" />
            <Button fx:id="btnEdit" mnemonicParsing="false" onAction="#onEditClicked" text="Изменить" />
            <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#onDeleteClicked" text="Удалить" />
            <FlowPane prefHeight="100.0" prefWidth="365.0">
               <children>
                  <TextField fx:id="productAmount" />
                  <Button fx:id="btnGenerate" mnemonicParsing="false" text="Сгенерировать" onAction="#onGenerateClicked"/>
                  <Button fx:id="btnStop" mnemonicParsing="false" prefHeight="30.0" prefWidth="94.0" text="Отменить" onAction="#onStopClicked"/>
                  <ProgressBar fx:id="progressBar" prefWidth="200.0" progress="0.0">
                     <FlowPane.margin>
                        <Insets top="10.0" />
                     </FlowPane.margin>
                  </ProgressBar>
               </children>
            </FlowPane>
         </children>
      </HBox>
   </bottom>
</BorderPane>
